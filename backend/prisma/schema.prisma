// Medora — Neon (PostgreSQL)
// https://neon.tech/docs/connect/connect-from-any-app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  Owner
  Doctor
  Receptionist
  SuperAdmin
}

enum ClinicStatus {
  active
  suspended
}

enum UserStatus {
  active
  suspended
}

model Clinic {
  id          String       @id @default(cuid())
  name        String       @db.Text
  slug        String       @unique @db.VarChar(60)
  phone       String       @db.VarChar(24)
  status      ClinicStatus @default(active)
  address     String?      @db.Text
  city        String?      @db.VarChar(100)
  state       String?      @db.VarChar(100)
  pincode     String?      @db.VarChar(20)
  specialties String[]     @default([])
  description String?      @db.Text
  latitude    Float?
  longitude   Float?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  patients      Patient[]
  visits        Visit[]
  appointments  Appointment[]
  prescriptions Prescription[]
  invoices      Invoice[]
  users         User[]
  userClinics   UserClinic[]

  logoUrl    String?  @map("logo_url") @db.Text
  brandColor String?  @map("brand_color") @db.VarChar(20)

  parentClinicId String?  @map("parent_clinic_id")
  parent         Clinic?  @relation("ClinicBranches", fields: [parentClinicId], references: [id], onDelete: SetNull)
  branches       Clinic[] @relation("ClinicBranches")

  featureFlags     ClinicFeatureFlags?
  subscription     ClinicSubscription?
  broadcasts       Broadcast[]
  supportTickets   SupportTicket[]
  paymentRecords   PaymentRecord[]
  deletionRequests DataDeletionRequest[]

  @@map("clinics")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.Text
  passwordHash String   @map("password_hash")
  name         String   @default("") @db.Text
  role         UserRole   @default(Owner)
  status       UserStatus @default(active)
  clinicId     String?    @map("clinic_id")
  clinic       Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  visits        Visit[]
  appointments  Appointment[]
  prescriptions Prescription[]
  invoices      Invoice[]

  emailVerified       Boolean  @default(false) @map("email_verified")

  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  userClinics              UserClinic[]

  @@index([clinicId])
  @@map("users")
}

model UserClinic {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  clinicId  String   @map("clinic_id")
  role      String   @default("owner") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([userId])
  @@map("user_clinics")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash") @db.VarChar(128)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rememberMe Boolean  @default(false) @map("remember_me")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

enum VisitStatus {
  waiting
  in_progress
  completed
}
enum AppointmentStatus {
  scheduled
  confirmed
  in_progress
  completed
  cancelled
  no_show
}
enum InvoiceStatus {
  paid
  unpaid
}
model Patient {
  id           String   @id @default(cuid())
  clinicId      String   @map("clinic_id")
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  address       String?   @db.Text
  age           Int?
  gender        String?
  nextVisitDate DateTime? @map("next_visit_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  visits        Visit[]
  appointments  Appointment[]
  prescriptions Prescription[]
  invoices      Invoice[]
  @@index([clinicId])
  @@map("patients")
}
model Visit {
  id         String     @id @default(cuid())
  clinicId   String     @map("clinic_id")
  clinic     Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String     @map("patient_id")
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String?    @map("doctor_id")
  doctor     User?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  title      String
  reason     String
  status     VisitStatus @default(waiting)
  startedAt  DateTime   @map("started_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  @@index([clinicId, status])
  @@index([patientId])
  @@map("visits")
}
model Appointment {
  id         String            @id @default(cuid())
  clinicId   String            @map("clinic_id")
  clinic     Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String            @map("patient_id")
  patient    Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String?           @map("doctor_id")
  doctor     User?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  date       DateTime
  startTime  String            @map("start_time")
  endTime    String            @map("end_time")
  reason     String
  status     AppointmentStatus @default(scheduled)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  @@index([clinicId, date])
  @@index([patientId])
  @@map("appointments")
}
model Prescription {
  id         String   @id @default(cuid())
  clinicId   String   @map("clinic_id")
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String   @map("patient_id")
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String?  @map("doctor_id")
  doctor     User?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  number     String
  date       DateTime
  diagnosis  String
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  items      PrescriptionItem[]
  @@unique([clinicId, number])
  @@index([clinicId, date])
  @@index([patientId])
  @@map("prescriptions")
}
model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String       @map("prescription_id")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  name           String
  dosage         String
  frequency      String
  duration       String
  notes          String?
  @@index([prescriptionId])
  @@map("prescription_items")
}
model Invoice {
  id         String        @id @default(cuid())
  clinicId   String        @map("clinic_id")
  clinic     Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String        @map("patient_id")
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String?       @map("doctor_id")
  doctor     User?         @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  number     String
  total      Int
  status     InvoiceStatus @default(unpaid)
  discount   Int?
  gst        Int?
  issuedAt   DateTime      @map("issued_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  items      InvoiceItem[]
  @@unique([clinicId, number])
  @@index([clinicId, status, issuedAt])
  @@index([patientId])
  @@map("invoices")
}
model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label     String
  amount    Int
  @@index([invoiceId])
  @@map("invoice_items")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clinicId  String?  @map("clinic_id")
  action    String   @db.VarChar(64)
  resource  String   @db.Text
  metadata  Json?
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([clinicId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Feature Flags ──────────────────────────────────────────────────────────────

model ClinicFeatureFlags {
  id                    String   @id @default(cuid())
  clinicId              String   @unique @map("clinic_id")
  clinic                Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  publicBooking         Boolean  @default(true) @map("public_booking")
  whatsappNotifications Boolean  @default(false) @map("whatsapp_notifications")
  multiClinic           Boolean  @default(false) @map("multi_clinic")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("clinic_feature_flags")
}

model PlatformConfig {
  id              String   @id @default(cuid())
  maintenanceMode Boolean  @default(false) @map("maintenance_mode")
  bannerMessage   String?  @db.Text @map("banner_message")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

// ── Broadcasts ────────────────────────────────────────────────────────────────

model Broadcast {
  id             String   @id @default(cuid())
  clinicId       String   @map("clinic_id")
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId         String?  @map("user_id")
  audience       String   @db.VarChar(32)
  kind           String   @db.VarChar(32)
  title          String   @db.Text
  body           String   @db.Text
  recipientCount Int      @map("recipient_count")
  sentAt         DateTime @default(now()) @map("sent_at")

  @@index([clinicId, sentAt])
  @@map("broadcasts")
}

// ── Billing ───────────────────────────────────────────────────────────────────

// ── SuperAdmin Broadcasts ─────────────────────────────────────────────────────

model SuperAdminBroadcast {
  id             String    @id @default(cuid())
  subject        String    @db.Text
  body           String    @db.Text
  segment        String    @db.VarChar(32)
  recipientCount Int       @map("recipient_count")
  sentBy         String?   @map("sent_by")
  scheduledAt    DateTime? @map("scheduled_at")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("superadmin_broadcasts")
}

// ── Support Tickets ───────────────────────────────────────────────────────────

model SupportTicket {
  id        String          @id @default(cuid())
  clinicId  String          @map("clinic_id")
  clinic    Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId    String?         @map("user_id")
  subject   String          @db.Text
  status    String          @default("open") @db.VarChar(32)
  priority  String          @default("medium") @db.VarChar(32)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  messages  TicketMessage[]

  @@index([clinicId])
  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String        @map("ticket_id")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?       @map("author_id")
  body      String        @db.Text
  isStaff   Boolean       @default(false) @map("is_staff")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("ticket_messages")
}

// ── Payment Records ───────────────────────────────────────────────────────────

model PaymentRecord {
  id          String    @id @default(cuid())
  clinicId    String    @map("clinic_id")
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  amount      Int
  plan        String    @db.VarChar(32)
  status      String    @default("paid") @db.VarChar(32)
  description String?   @db.Text
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([clinicId, createdAt])
  @@map("payment_records")
}

// ── GDPR Deletion Requests ────────────────────────────────────────────────────

model DataDeletionRequest {
  id          String    @id @default(cuid())
  clinicId    String    @map("clinic_id")
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  requestedBy String?   @map("requested_by")
  reason      String?   @db.Text
  status      String    @default("pending") @db.VarChar(32)
  scheduledAt DateTime? @map("scheduled_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([clinicId])
  @@index([status])
  @@map("data_deletion_requests")
}

// ── Custom Plans ──────────────────────────────────────────────────────────────

model CustomPlan {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  price           Int
  annualPrice     Int?     @map("annual_price")
  planId          String?  @map("plan_id") @db.VarChar(32)
  maxPatients     Int?     @map("max_patients")
  maxUsers        Int?     @map("max_users")
  features        Json     @default("{}")
  displayFeatures String[] @default([]) @map("display_features")
  highlighted     Boolean  @default(false)
  ctaText         String?  @db.VarChar(100) @map("cta_text")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("custom_plans")
}

model ClinicSubscription {
  id                 String    @id @default(cuid())
  clinicId           String    @unique @map("clinic_id")
  clinic             Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan               String    @default("trial") @db.VarChar(32)
  billingStatus      String    @default("trial") @map("billing_status") @db.VarChar(32)
  trialEndsAt        DateTime? @map("trial_ends_at")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("clinic_subscriptions")
}
