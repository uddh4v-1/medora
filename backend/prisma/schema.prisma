// Medora — Neon (PostgreSQL)
// https://neon.tech/docs/connect/connect-from-any-app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Owner
  Doctor
  Receptionist
}

model Clinic {
  id        String   @id @default(cuid())
  name      String   @db.Text
  slug      String   @unique @db.VarChar(60)
  phone     String   @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  patients      Patient[]
  visits        Visit[]
  appointments  Appointment[]
  prescriptions Prescription[]
  invoices      Invoice[]

  users User[]

  @@map("clinics")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.Text
  passwordHash String   @map("password_hash")
  name         String   @default("") @db.Text
  role         UserRole @default(Owner)
  clinicId     String?  @map("clinic_id")
  clinic       Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  visits        Visit[]
  appointments  Appointment[]
  prescriptions Prescription[]
  invoices      Invoice[]

  passwordResetTokens PasswordResetToken[]

  @@index([clinicId])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum VisitStatus {
  waiting
  in_progress
  completed
}
enum AppointmentStatus {
  scheduled
  confirmed
  in_progress
  completed
  cancelled
  no_show
}
enum InvoiceStatus {
  paid
  unpaid
}
model Patient {
  id           String   @id @default(cuid())
  clinicId      String   @map("clinic_id")
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  age           Int?
  gender        String?
  nextVisitDate DateTime? @map("next_visit_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  visits        Visit[]
  appointments  Appointment[]
  prescriptions Prescription[]
  invoices      Invoice[]
  @@index([clinicId])
  @@map("patients")
}
model Visit {
  id         String     @id @default(cuid())
  clinicId   String     @map("clinic_id")
  clinic     Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String     @map("patient_id")
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String?    @map("doctor_id")
  doctor     User?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  title      String
  reason     String
  status     VisitStatus @default(waiting)
  startedAt  DateTime   @map("started_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  @@index([clinicId, status])
  @@index([patientId])
  @@map("visits")
}
model Appointment {
  id         String            @id @default(cuid())
  clinicId   String            @map("clinic_id")
  clinic     Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String            @map("patient_id")
  patient    Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String?           @map("doctor_id")
  doctor     User?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  date       DateTime
  startTime  String            @map("start_time")
  endTime    String            @map("end_time")
  reason     String
  status     AppointmentStatus @default(scheduled)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  @@index([clinicId, date])
  @@index([patientId])
  @@map("appointments")
}
model Prescription {
  id         String   @id @default(cuid())
  clinicId   String   @map("clinic_id")
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String   @map("patient_id")
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String?  @map("doctor_id")
  doctor     User?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  number     String
  date       DateTime
  diagnosis  String
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  items      PrescriptionItem[]
  @@unique([clinicId, number])
  @@index([clinicId, date])
  @@index([patientId])
  @@map("prescriptions")
}
model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String       @map("prescription_id")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  name           String
  dosage         String
  frequency      String
  duration       String
  notes          String?
  @@index([prescriptionId])
  @@map("prescription_items")
}
model Invoice {
  id         String        @id @default(cuid())
  clinicId   String        @map("clinic_id")
  clinic     Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String        @map("patient_id")
  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String?       @map("doctor_id")
  doctor     User?         @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  number     String
  total      Int
  status     InvoiceStatus @default(unpaid)
  discount   Int?
  gst        Int?
  issuedAt   DateTime      @map("issued_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  items      InvoiceItem[]
  @@unique([clinicId, number])
  @@index([clinicId, status, issuedAt])
  @@index([patientId])
  @@map("invoices")
}
model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label     String
  amount    Int
  @@index([invoiceId])
  @@map("invoice_items")
}
