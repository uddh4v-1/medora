# Server
PORT=4100
NODE_ENV=development

# Neon — copy from https://console.neon.tech → your project → Connection details
# Use the "pooled" / pooler connection for DATABASE_URL (serverless-friendly).
# Use the "direct" / non-pooled connection for DIRECT_URL (Prisma migrations).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# If Neon gives you a separate *direct* vs *pooled* URL, add migration URL per Neon + Prisma docs:
# https://www.prisma.io/docs/orm/overview/databases/neon
# DIRECT_URL="postgresql://..."

# CORS — comma-separated origins (optional; empty = allow any in dev)
# CORS_ORIGINS=http://localhost:3000

# JWT — use a long random string in production (openssl rand -hex 32)
JWT_SECRET="change-me-in-production-min-16-chars"
JWT_EXPIRES_IN=7d

# HttpOnly cookie storing the JWT (default name)
# AUTH_COOKIE_NAME=medora_session
