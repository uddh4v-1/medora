# Server
PORT=4100
NODE_ENV=development

# Neon — copy from https://console.neon.tech → your project → Connection details
# Use the "pooled" / pooler connection for DATABASE_URL (serverless-friendly).
# Use the "direct" / non-pooled connection for DIRECT_URL (Prisma migrations).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# If Neon gives you a separate *direct* vs *pooled* URL, add migration URL per Neon + Prisma docs:
# https://www.prisma.io/docs/orm/overview/databases/neon
# DIRECT_URL="postgresql://..."

# CORS — comma-separated origins (optional; empty = allow any in dev)
# CORS_ORIGINS=http://localhost:3000

# JWT — use a long random string in production (openssl rand -hex 32)
JWT_SECRET="change-me-in-production-min-16-chars"
# JWT for register (`issueAccessToken` default)
JWT_EXPIRES_IN=7d
# Login: cookie + token lifetime when Remember me is off / on
JWT_SESSION_EXPIRES_IN=1d
JWT_REMEMBER_ME_EXPIRES_IN=30d

# HttpOnly cookie storing the JWT (default name)
# AUTH_COOKIE_NAME=medora_session

# Frontend origin for links in transactional emails (password reset)
APP_ORIGIN=http://localhost:3000
# PASSWORD_RESET_TTL_MINUTES=60

# ── Transactional email (password reset) ─────────────────
# Without configuration, reset links only appear in the API console.
#
# Option A — Gmail: use a Google [App Password](https://support.google.com/accounts/answer/185833), not your login password.
# Uncomment and fill in — real values belong in `.env` only (never commit secrets).
# USE_GMAIL_SMTP=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_FROM="Medora <you@gmail.com>"
#
# Option B — any SMTP relay (Mailtrap, SendGrid SMTP, SES, etc.):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Medora <no-reply@yourdomain.com>"

# ── Razorpay (subscription payments) ──────────────────────
# Get keys from https://dashboard.razorpay.com → Settings → API Keys
# Test keys (rzp_test_*) charge no real money — safe for development.
# Test_Key_ID=rzp_test_xxxxxxxxxxxx
# Test_Key_Secret=xxxxxxxxxxxxxxxxxxxxxxxx
